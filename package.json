    "keybindings": [
      {
        "command": "markhov.toggle",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus && editorLangId == markdown && !isInDiffEditor"
      },
      {
        "command": "markhov.toggle",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId == markhov.editor && !panelFocus && !sideBarFocus && !auxiliaryBarFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markhov.openEditor",
          "when": "resourceLangId == markdown && activeEditor == workbench.editors.files.textFileEditor && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "markhov.exportPdf",
          "when": "activeCustomEditorId == 'markhov.editor'",
          "group": "navigation@1"
        },
        {
          "command": "markhov.openRaw",
          "when": "activeCustomEditorId == markhov.editor",
          "group": "navigation"
        },
        {
          "command": "markhov.exportPdf",
          "when": "resourceLangId == markdown && activeEditor == workbench.editors.files.textFileEditor && !isInDiffEditor",
          "group": "markhov"
        }
      ],
      "explorer/context": [
        {
          "command": "markhov.openWith",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "markhov.exportPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "submenu": "markhov.menu.width",
          "when": "webviewId == 'markhov.editor'",
          "group": "6_markhov@1"
        },
        {
          "submenu": "markhov.menu.fontSize",
          "when": "webviewId == 'markhov.editor'",
          "group": "6_markhov@2"
