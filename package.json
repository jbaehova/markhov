{
  "name": "markhov",
  "displayName": "Markhov",
  "description": "A quiet, minimal live preview editor for Markdown. Formatting renders as you type, with clean PDF export.",
  "version": "0.3.0",
  "publisher": "jbaehova",
  "author": {
    "name": "Johnny Bae"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#F4F7FD",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jbaehova/markhov.git"
  },
  "bugs": {
    "url": "https://github.com/jbaehova/markhov/issues"
  },
  "homepage": "https://github.com/jbaehova/markhov#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "live preview",
    "wysiwyg",
    "writing",
    "notes",
    "pdf",
    "export pdf"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "vscode:prepublish": "rm -rf dist && node esbuild.mjs --production",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "markhov.editor",
        "displayName": "Markhov",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markhov.toggle",
        "title": "Toggle Editor",
        "category": "Markhov"
      },
      {
        "command": "markhov.openEditor",
